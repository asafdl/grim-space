; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="grim-space"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/icon.png"
boot_splash/show_image=false

[autoload]

Session="*res://src/application/Session.cs"
Music="*res://src/application/Music.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="grim-space"

[editor]

movie_writer/movie_file="/Users/asafd/git/grim-space/dist/demo.avi"
movie_writer/fps=24

[gui]

timers/tooltip_delay_sec=0.25
theme/custom="res://assets/ui/themes/informative_theme.tres"

[layer_names]

3d_physics/layer_20="camera_occluder"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
