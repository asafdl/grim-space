[gd_resource type="Theme" load_steps=4 format=3]

[sub_resource type="SystemFont" id="Font_sans"]
font_names = PackedStringArray("SF Pro Text", "Segoe UI", "Roboto", "Helvetica Neue", "Arial")
allow_system_fallback = true

[sub_resource type="StyleBoxFlat" id="StyleBox_informative_panel"]
bg_color = Color(0.06, 0.09, 0.14, 0.94)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.22, 0.32, 0.42, 0.75)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 10
content_margin_top = 10
content_margin_right = 10
content_margin_bottom = 10

[resource]
default_font = SubResource("Font_sans")
default_font_size = 16
Label/colors/font_color = Color(0.82, 0.88, 0.92, 1)
HudHeadingLabel/colors/font_color = Color(0.55, 0.62, 0.7, 1)
HudHeadingLabel/font_sizes/font_size = 12
EntryTitleLabel/colors/font_color = Color(0.82, 0.88, 0.92, 1)
EntryTitleLabel/font_sizes/font_size = 16
EntryBodyLabel/colors/font_color = Color(0.55, 0.62, 0.7, 1)
EntryBodyLabel/font_sizes/font_size = 14
InformativeHudPanelContainer/styles/panel = SubResource("StyleBox_informative_panel")
