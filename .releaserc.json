{
  "branches": ["master"],
  "tagFormat": "v${version}-pre-alpha",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release-assets/grim-space-linux-x86_64.zip",
            "label": "Linux x86_64"
          },
          {
            "path": "release-assets/grim-space-windows-x86_64.zip",
            "label": "Windows x86_64"
          },
          {
            "path": "release-assets/grim-space-macos.zip",
            "label": "macOS"
          }
        ]
      }
    ]
  ]
}
