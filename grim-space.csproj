<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>grimspace</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InformationalVersion Condition="'$(GRIM_SPACE_VERSION)' != ''">$(GRIM_SPACE_VERSION)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(GRIM_SPACE_VERSION)' != ''">
      <_Parameter1>GrimSpaceReleaseVersion</_Parameter1>
      <_Parameter2>$(GRIM_SPACE_VERSION)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(DISCORD_ISSUE_WEBHOOK_URL)' != ''">
      <_Parameter1>DiscordIssueWebhookUrl</_Parameter1>
      <_Parameter2>$(DISCORD_ISSUE_WEBHOOK_URL)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="grim-space.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="geometry3Sharp" Version="1.0.324" />
    <PackageReference Include="UniqueNameGenerator" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="grim-space.Tests" />
  </ItemGroup>
</Project>