<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>grimspace</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="grim-space.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="geometry3Sharp" Version="1.0.324" />
    <PackageReference Include="UniqueNameGenerator" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="grim-space.Tests" />
  </ItemGroup>
  <Target Name="GenerateIssueReportChannels" BeforeTargets="BeforeCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/scripts/generate_issue_report_channels.py&quot;" />
  </Target>
</Project>